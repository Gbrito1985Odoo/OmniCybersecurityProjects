# TraceLens - variables de entorno (Fase 1)
TRACELENS_DB_URL=sqlite+aiosqlite:///./data/tracelens.db
TRACELENS_VECTOR_STORE_TYPE=chroma
TRACELENS_CHROMA_PERSIST_DIR=./data/chroma
TRACELENS_LOG_LEVEL=INFO
TRACELENS_ANALYSIS_MODEL=llama3.2:3b
TRACELENS_EMBED_MODEL=nomic-embed-text
TRACELENS_OLLAMA_HOST=http://localhost:11434
TRACELENS_INGESTION_BUFFER_SIZE=1000
TRACELENS_INGESTION_CHECKPOINT_INTERVAL=100
